extends layout.pug

block title
	title The Untitled

block content
	if !session
		//- Blank for now

	else if !session.user.isEligibleFor(process.env.SEASON)
		div.row
			div.col-12
				div.alert.alert-warning
					| You are not eligible to participate in the #{process.env.SEASON} season. Contact the commissioner to join.

	else
		div.row
			div.col-12.col-lg-8
				h4 Week #{currentWeek}

				if !currentWeekPick
					div.alert.alert-warning
						| You haven't made a pick for Week #{currentWeek} yet.

				div.row
					each conference in conferences
						div.col-12.col-md-6
							each division in divisions
								h6.text-muted.mt-3 #{conference} #{division}
								table.table.table-sm.mb-0
									tbody
										each team in teamsByDivision[conference][division]
											-
												var isCurrentPick = currentWeekPick && currentWeekPick.team === team.abbreviation;
												var isUsed = usedTeams.includes(team.abbreviation) && !isCurrentPick;
												var standing = standingsMap[team.abbreviation] || { wins: 0, losses: 0, ties: 0 };
												var record = standing.wins + '-' + standing.losses + (standing.ties ? '-' + standing.ties : '');

											tr(class=(isCurrentPick ? 'table-active' : '') class=(isUsed ? 'text-muted' : ''))
												td.align-middle.text-center(style='width: 40px')
													if isCurrentPick
														a.btn.btn-sm.btn-primary(href='/unpick') ✓
													else if isUsed
														span.btn.btn-sm.btn-outline-muted.disabled ·
													else
														a.btn.btn-sm.btn-outline-muted(href='/pick/' + team.abbreviation) ○
												td.align-middle
													div.d-flex.align-items-center
														img.team-logo.mr-2(src='/images/' + team.abbreviation.toLowerCase() + '.png')
														span.team-name #{team.name}
												td.align-middle.text-right #{record}

			div.col-12.col-lg-4.mt-4.mt-lg-0
				h4 Your Picks
				table.table.table-sm
					thead
						tr
							th.text-center Week
							th.text-center Team
					tbody
						- for (var week = 1; week <= 18; week++)
							- var pick = picks.find(p => p.week === week)
							tr(class=(week === currentWeek ? 'table-active' : ''))
								td.text-center #{week}
								td.text-center
									if pick
										| #{pick.team}
									else if week < currentWeek
										span.text-danger Missed
									else if week === currentWeek
										span.text-muted -
									else
										| -
