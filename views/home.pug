extends layout.pug

block title
	title The Untitled

block content
	if !session
		//- Blank for now

	else if !session.user.isEligibleFor(process.env.SEASON)
		div.row
			div.col-12
				div.alert.alert-warning
					| You are not eligible to participate in the #{process.env.SEASON} season. Contact the commissioner to join.

	else
		div.row
			div.col-12.col-lg-8
				h4 Week #{currentWeek}

				if currentWeekPick
					div.alert.alert-success
						| Your pick: 
						strong #{currentWeekPick.team}

				else
					div.alert.alert-warning
						| You haven't made a pick for Week #{currentWeek} yet.

				-
					var conferences = ['AFC', 'NFC'];
					var divisions = ['East', 'North', 'South', 'West'];

				each conference in conferences
					each division in divisions
						div.row.mb-3
							each team in teams.filter(t => t.conference === conference && t.division === division)
								-
									var isCurrentPick = currentWeekPick && currentWeekPick.team === team.abbreviation;
									var isUsed = usedTeams.includes(team.abbreviation) && !isCurrentPick;
									var btnClass = 'btn-outline-secondary';
									var href = '/pick/' + team.abbreviation;
									var disabled = false;

									if (isCurrentPick) {
										btnClass = 'btn-secondary';
										href = '/unpick';
									} else if (isUsed) {
										btnClass = 'btn-outline-secondary disabled';
										href = '#';
										disabled = true;
									}

								div.col-6.col-md-3.mb-2
									a.team-btn.btn.btn-block.p-2.d-flex.align-items-center(href=href class=btnClass class=(disabled ? 'disabled' : ''))
										img.team-logo.mr-2(src='/images/' + team.abbreviation.toLowerCase() + '.png')
										span.team-name #{team.name}

			div.col-12.col-lg-4.mt-4.mt-lg-0
				h4 Your Picks
				table.table.table-sm
					thead
						tr
							th.text-center Week
							th.text-center Team
					tbody
						- for (var week = 1; week <= 18; week++)
							- var pick = picks.find(p => p.week === week)
							tr(class=(week === currentWeek ? 'table-active' : ''))
								td.text-center #{week}
								td.text-center
									if pick
										| #{pick.team}
									else if week < currentWeek
										span.text-danger Missed
									else if week === currentWeek
										span.text-muted -
									else
										| -
