extends layout.pug

block title
	+title()

block content
	if !session
		div.row
			each conference in conferences
				div.col-12.col-md-6
					each division in divisions
						h6.text-muted.mt-3 #{conference} #{division}
						table.table.table-sm.mb-0
							tbody
								each team in teamsByDivision[conference][division]
									-
										var standing = standingsMap[team.abbreviation] || { wins: 0, losses: 0, ties: 0 };
										var record = standing.wins + '-' + standing.losses + (standing.ties ? '-' + standing.ties : '');
										var probability = standing.playoffProbability;

									tr
										td.align-middle
											div.d-flex.align-items-center
												img.team-logo.mr-2(src='/images/' + team.abbreviation.toLowerCase() + '.png')
												a.team-name(href='/teams/' + team.abbreviation) #{team.name}
										td.align-middle.text-right.tabular-nums(style='width: 50px') #{record}
										td.align-middle.text-right.text-muted.small.tabular-nums(style='width: 55px')
											if probability != null
												| #{probability.toFixed(1)}%

	else if !session.user.isEligibleFor(process.env.SEASON)
		div.row
			div.col-12
				div.alert.alert-warning
					| You are not eligible to participate in the #{process.env.SEASON} season. Contact the commissioner to join.

	else
		div.row(class=(isPickLocked ? 'pick-locked' : ''))
			div.col-12.col-lg-8
				h4 Week #{currentWeek}

				if !currentWeekPick && !isPickLocked
					div.alert.alert-warning
						| You haven't made a pick for Week #{currentWeek} yet.

				div.row
					each conference in conferences
						div.col-12.col-md-6
							each division in divisions
								h6.text-muted.mt-3 #{conference} #{division}
								table.table.table-sm.mb-0
									tbody
										each team in teamsByDivision[conference][division]
											-
												var isCurrentPick = currentWeekPick && currentWeekPick.team === team.abbreviation;
												var isUsed = usedTeams.includes(team.abbreviation) && !isCurrentPick;
												var usedInWeek = isUsed ? picks.find(p => p.team === team.abbreviation).week : null;
												var standing = standingsMap[team.abbreviation] || { wins: 0, losses: 0, ties: 0 };
												var record = standing.wins + '-' + standing.losses + (standing.ties ? '-' + standing.ties : '');
												var isTeamLocked = lockedTeams && lockedTeams.has(team.abbreviation);

											-
												var probability = standing.playoffProbability;

											tr(class=(isCurrentPick ? 'table-active' : ''))
												td.align-middle.text-center(style='width: 40px')
													if isCurrentPick
														if isPickLocked
															span.btn.btn-sm.btn-secondary.disabled.pick-btn
																i.fa-solid.fa-lock
														else
															a.btn.btn-sm.btn-primary.pick-btn(href='/unpick') ✓
													else if isUsed
														span.btn.btn-sm.btn-outline-muted.disabled.pick-btn #{usedInWeek}
													else if isTeamLocked
														span.btn.btn-sm.btn-outline-muted.disabled.pick-btn
															i.fa-solid.fa-lock
													else
														a.btn.btn-sm.btn-outline-muted.pick-btn(href='/pick/' + team.abbreviation) ○
												td.align-middle
													div.d-flex.align-items-center
														img.team-logo.mr-2(src='/images/' + team.abbreviation.toLowerCase() + '.png')
														a.team-name(href='/teams/' + team.abbreviation) #{team.name}
												td.align-middle.text-right.tabular-nums(style='width: 50px') #{record}
												td.align-middle.text-right.text-muted.small.tabular-nums(style='width: 55px')
													if probability != null
														| #{probability.toFixed(1)}%

			div.col-12.col-lg-4.mt-4.mt-lg-0
				h4 Your Picks
				table.table.table-sm
					thead
						tr
							th.text-center Week
							th.text-center Team
					tbody
						- for (var week = 1; week <= 18; week++)
							- var pick = picks.find(p => p.week === week)
							tr(class=(week === currentWeek ? 'table-active' : ''))
								td.text-center #{week}
								td.text-center
									if pick
										| #{pick.team}
									else if week < currentWeek
										span.text-danger Missed
									else if week === currentWeek
										span.text-muted -
									else
										| -
