extends layout.pug

block title
	+title(team.location + ' ' + team.name)

block content
	div.row
		div.col-12.col-md-8.col-lg-6
			h2 #{team.location} #{team.name}

			table.table.table-sm
				thead
					tr
						th.text-center Week
						th
						th Opponent
						th.text-center Result
				tbody
					each game in schedule
						tr(class=(game.isBye ? 'bye-week' : ''))
							td.text-center #{game.week}
							td.text-right
								if !game.isBye && !game.isHome
									| at
							td
								if game.isBye
									| Bye
								else
									a(href='/teams/' + game.opponent) #{game.opponentName}
							td.text-center
								if game.isBye
									| -
								else if game.result
									span(class=(game.result === 'W' ? 'text-success' : game.result === 'L' ? 'text-danger' : ''))
										strong #{game.result}
									|  #{game.teamScore}-#{game.opponentScore}
								else if game.isPastStartTime
									span In Progress
								else
									span -
