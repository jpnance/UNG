include mixins.pug

doctype html
html(lang='en' xml:lang='en' xmlns='http://www.w3.org/1999/xhtml')
	head
		meta(charset='utf-8')
		meta(name='viewport' content='width=device-width, initial-scale=1, shrink-to-fit=no')
		meta(name='google' content='notranslate')

		block title

		block styles
			link(href='/css/bootstrap.min.css' rel='stylesheet')
			link(href='/css/untitled.css' rel='stylesheet')

		block scripts
			script(src='/js/jquery.min.js' type='text/javascript')
			script(src='/js/bootstrap.min.js' type='text/javascript')
			script(src='/js/untitled.js' type='text/javascript')

		link(href='/images/logo.svg' rel='icon' type='image/svg+xml')
		link(href='/images/favicon.ico' rel='icon' sizes='any')

	body
		-
			var playoffsSet = typeof season !== 'undefined' && season && season.playoffTeams && season.playoffTeams.length === 14;
			var standingsLabel = playoffsSet ? 'Standings' : '"Standings"';

		nav.navbar.navbar-expand-md.navbar-light.bg-light.sticky-top.mb-3
			a.navbar-brand(href='/')
				img.logo.mr-2(src='/images/logo.svg' height='30')
				strong.align-middle The Untitled
			button.navbar-toggler(type='button' data-toggle='collapse' data-target='#navbarNav')
				span.navbar-toggler-icon
			div.collapse.navbar-collapse#navbarNav
				ul.navbar-nav
					li.nav-item.py-1
						a.nav-link(href='/') Home
					li.nav-item.py-1
						a.nav-link(href='/standings') #{standingsLabel}
					li.nav-item.py-1
						a.nav-link(href='/picks') Picks
					li.nav-item.py-1
						a.nav-link(href='/rules') Rules
					if session
						li.nav-item.dropdown.py-1
							a.nav-link.dropdown-toggle(href='#' data-toggle='dropdown')
								| Log Out
							div.log-out.dropdown-menu.py-0
								a.this-device.dropdown-item(href=process.env.LOGIN_SERVICE_EXTERNAL + '/sessions/delete') This Device
								a.all-devices.dropdown-item(href=process.env.LOGIN_SERVICE_EXTERNAL + '/sessions/deleteAll') All Devices
					else
						li.nav-item.py-1
							a.nav-link(href='/login') Log In

		div.container.pb-3
			block content

		div#modal.modal.fade
			div.modal-dialog
				div.modal-content
					div.modal-header
						h5.modal-title Error
						button.close(type='button' data-dismiss='modal'): span &times;
					div.modal-body Default error message
