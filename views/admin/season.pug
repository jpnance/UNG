extends ../layout.pug

block title
	+title('Season', 'Admin')

block content
	h2 Season Management

	if error
		div.alert.alert-danger #{error}

	else
		div.card.mb-4
			div.card-header Playoff Teams (#{season.playoffTeams ? season.playoffTeams.length : 0}/14)
			div.card-body
				form(action='/admin/season/playoffs' method='POST')
					div.row
						div.col-12.col-md-6
							h6 AFC
							each team in teams.filter(t => t.conference === 'AFC')
								div.form-check
									input.form-check-input(type='checkbox' name='playoff_' + team.abbreviation id='playoff_' + team.abbreviation checked=(season.playoffTeams && season.playoffTeams.includes(team.abbreviation)))
									label.form-check-label(for='playoff_' + team.abbreviation) #{team.location} #{team.name}
						div.col-12.col-md-6
							h6 NFC
							each team in teams.filter(t => t.conference === 'NFC')
								div.form-check
									input.form-check-input(type='checkbox' name='playoff_' + team.abbreviation id='playoff_' + team.abbreviation checked=(season.playoffTeams && season.playoffTeams.includes(team.abbreviation)))
									label.form-check-label(for='playoff_' + team.abbreviation) #{team.location} #{team.name}
					div.mt-3
						button.btn.btn-warning(type='submit') Set Playoff Teams
