extends layout.pug

block title
	if playoffsSet
		+title('Standings')
	else
		+title('"Standings"')

block content
	div.row
		div.col-12
			if playoffsSet
				h2 Standings
			else
				h2 "Standings"

			table.table.table-sm
				thead
					tr
						th.text-center Rank
						th Player
						if playoffsSet
							th.text-center Score
							th Tiebreakers
						else
							th.text-center Projected
				tbody
					each standing in standings
						tr(class=(standing.isEliminated ? 'entrant-eliminated' : ''))
							td.text-center
								if standing.isEliminated
									span.text-muted E
								else if standing.showRank
									| #{standing.rank}
							td #{standing.user.displayName}
							if playoffsSet
								td.text-center
									strong #{standing.score}
								td
									if standing.tiebreakers.length > 0
										each tb, index in standing.tiebreakers
											if index > 0
												| , 
											| #{tb}
									else
										span.text-muted -
							else
								td.text-center
									if standing.isEliminated
										span.text-muted -
									else
										| #{standing.visibleProjectedScore}
